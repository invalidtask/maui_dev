<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:converters="clr-namespace:VaughnLive.Converters">

    <!-- Import Colors -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Converters -->
    <converters:InvertedBoolConverter x:Key="InvertedBoolConverter"/>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <converters:ViewerCountConverter x:Key="ViewerCountConverter"/>
    <converters:DurationConverter x:Key="DurationConverter"/>
    <converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
    <converters:FullscreenHeightConverter x:Key="FullscreenHeightConverter"/>

    <!-- Label Styles -->
    <Style TargetType="Label" x:Key="TitleLabel">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryDark}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontFamily" Value="InterBold"/>
    </Style>

    <Style TargetType="Label" x:Key="SubtitleLabel">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryDark}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontFamily" Value="InterMedium"/>
    </Style>

    <Style TargetType="Label" x:Key="BodyLabel">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryDark}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="InterRegular"/>
    </Style>

    <Style TargetType="Label" x:Key="CaptionLabel">
        <Setter Property="TextColor" Value="{StaticResource TextSecondaryDark}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontFamily" Value="InterRegular"/>
    </Style>

    <!-- Button Styles -->
    <Style TargetType="Button" x:Key="PrimaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryAccent}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontFamily" Value="InterMedium"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryAccentHover}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevatedDark}"/>
                            <Setter Property="TextColor" Value="{StaticResource TextSecondaryDark}"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="SecondaryButton">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevatedDark}"/>
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryDark}"/>
        <Setter Property="FontFamily" Value="InterMedium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style TargetType="Button" x:Key="DangerButton">
        <Setter Property="BackgroundColor" Value="{StaticResource Error}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontFamily" Value="InterMedium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <Style TargetType="Button" x:Key="LiveButton">
        <Setter Property="BackgroundColor" Value="{StaticResource LiveIndicator}"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="FontFamily" Value="InterBold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="24,16"/>
    </Style>

    <!-- Entry Styles -->
    <Style TargetType="Entry" x:Key="DefaultEntry">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryDark}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondaryDark}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDark}"/>
        <Setter Property="FontFamily" Value="InterRegular"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Frame Styles -->
    <Style TargetType="Frame" x:Key="CardFrame">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDark}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="HasShadow" Value="False"/>
        <Setter Property="BorderColor" Value="Transparent"/>
    </Style>

    <Style TargetType="Frame" x:Key="LiveBadge">
        <Setter Property="BackgroundColor" Value="{StaticResource LiveIndicator}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HasShadow" Value="False"/>
    </Style>

    <!-- ActivityIndicator Style -->
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource PrimaryAccent}"/>
    </Style>

    <!-- SearchBar Style -->
    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource TextPrimaryDark}"/>
        <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondaryDark}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDark}"/>
        <Setter Property="CancelButtonColor" Value="{StaticResource PrimaryAccent}"/>
    </Style>

    <!-- Shell Styles -->
    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource BackgroundDark}"/>
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource TextPrimaryDark}"/>
        <Setter Property="Shell.TitleColor" Value="{StaticResource TextPrimaryDark}"/>
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource SurfaceDark}"/>
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource PrimaryAccent}"/>
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource TextSecondaryDark}"/>
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource PrimaryAccent}"/>
    </Style>

    <!-- Page Style -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDark}"/>
    </Style>

    <!-- NavigationPage Style -->
    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{StaticResource SurfaceDark}"/>
        <Setter Property="BarTextColor" Value="{StaticResource TextPrimaryDark}"/>
    </Style>

</ResourceDictionary>
