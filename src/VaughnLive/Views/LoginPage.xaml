<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VaughnLive.Views.LoginPage"
             Title="Sign In"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <!-- Logo -->
            <Image Source="logo.png"
                   HeightRequest="80"
                   Aspect="AspectFit"
                   Margin="0,0,0,24"/>

            <Label Text="Welcome Back"
                   TextColor="{StaticResource TextPrimaryDark}"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>

            <Label Text="Sign in to continue"
                   TextColor="{StaticResource TextSecondaryDark}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,16"/>

            <!-- Username -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Username"
                       TextColor="{StaticResource TextSecondaryDark}"
                       FontSize="12"/>
                <Frame Padding="0" CornerRadius="8" BackgroundColor="{StaticResource SurfaceDark}">
                    <Entry x:Name="UsernameEntry"
                           Placeholder="Enter your username"
                           TextColor="{StaticResource TextPrimaryDark}"
                           PlaceholderColor="{StaticResource TextSecondaryDark}"
                           BackgroundColor="Transparent"
                           Margin="12,0"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Password"
                       TextColor="{StaticResource TextSecondaryDark}"
                       FontSize="12"/>
                <Frame Padding="0" CornerRadius="8" BackgroundColor="{StaticResource SurfaceDark}">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Enter your password"
                           IsPassword="True"
                           TextColor="{StaticResource TextPrimaryDark}"
                           PlaceholderColor="{StaticResource TextSecondaryDark}"
                           BackgroundColor="Transparent"
                           Margin="12,0"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Sign In Button -->
            <Button x:Name="SignInButton"
                    Text="Sign In"
                    BackgroundColor="{StaticResource PrimaryAccent}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,16,0,0"
                    Clicked="OnSignInClicked"/>

            <!-- Register Link -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="Don't have an account?"
                       TextColor="{StaticResource TextSecondaryDark}"
                       FontSize="14"/>
                <Label Text="Sign Up"
                       TextColor="{StaticResource PrimaryAccent}"
                       FontSize="14"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignUpTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
