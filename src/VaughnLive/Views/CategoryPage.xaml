<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:VaughnLive.Models"
             xmlns:controls="clr-namespace:VaughnLive.Controls"
             x:Class="VaughnLive.Views.CategoryPage"
             Title="Category"
             BackgroundColor="{StaticResource BackgroundDark}">

    <RefreshView x:Name="RefreshView">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="16">

                <!-- Category Header -->
                <HorizontalStackLayout Spacing="12">
                    <Image x:Name="CategoryImage"
                           HeightRequest="60"
                           WidthRequest="60"
                           Aspect="AspectFit"/>
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label x:Name="CategoryNameLabel"
                               TextColor="{StaticResource TextPrimaryDark}"
                               FontSize="20"
                               FontAttributes="Bold"/>
                        <Label x:Name="CategoryViewersLabel"
                               TextColor="{StaticResource TextSecondaryDark}"
                               FontSize="14"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Streams -->
                <CollectionView x:Name="StreamsCollection">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"
                                         HorizontalItemSpacing="12"
                                         VerticalItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LiveStream">
                            <controls:StreamCard/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No streams in this category"
                               TextColor="{StaticResource TextSecondaryDark}"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               Margin="0,32"/>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
