<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VaughnLive.Views.EditProfilePage"
             Title="Edit Profile"
             BackgroundColor="{StaticResource BackgroundDark}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Avatar -->
            <Frame CornerRadius="50"
                   HeightRequest="100"
                   WidthRequest="100"
                   Padding="0"
                   HorizontalOptions="Center"
                   IsClippedToBounds="True">
                <Image x:Name="AvatarImage"
                       Aspect="AspectFill"/>
            </Frame>

            <Button Text="Change Avatar"
                    BackgroundColor="{StaticResource SurfaceDark}"
                    TextColor="{StaticResource PrimaryAccent}"
                    CornerRadius="8"
                    HeightRequest="40"
                    HorizontalOptions="Center"
                    Clicked="OnChangeAvatarClicked"/>

            <!-- Display Name -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Display Name"
                       TextColor="{StaticResource TextSecondaryDark}"
                       FontSize="12"/>
                <Frame Padding="0" CornerRadius="8" BackgroundColor="{StaticResource SurfaceDark}">
                    <Entry x:Name="DisplayNameEntry"
                           TextColor="{StaticResource TextPrimaryDark}"
                           BackgroundColor="Transparent"
                           Margin="12,0"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Bio -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Bio"
                       TextColor="{StaticResource TextSecondaryDark}"
                       FontSize="12"/>
                <Frame Padding="0" CornerRadius="8" BackgroundColor="{StaticResource SurfaceDark}">
                    <Editor x:Name="BioEditor"
                            TextColor="{StaticResource TextPrimaryDark}"
                            BackgroundColor="Transparent"
                            HeightRequest="100"
                            Margin="12"/>
                </Frame>
            </VerticalStackLayout>

            <!-- Save Button -->
            <Button Text="Save Changes"
                    BackgroundColor="{StaticResource PrimaryAccent}"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50"
                    Margin="0,16,0,0"
                    Clicked="OnSaveClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
